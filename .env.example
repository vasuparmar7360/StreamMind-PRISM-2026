# OwnMind AI Backend — Environment Configuration
APP_NAME="OwnMind AI Backend"
APP_VERSION="0.1.0"
HOST="127.0.0.1"
PORT=8000
DEBUG=true

# Frontend URL (Next.js default: http://localhost:3000, Vite default: http://localhost:5173)
FRONTEND_URL="http://localhost:3000"

# Comma-separated allowed CORS origins for local development
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# Base URL for the FastAPI backend used by the Next.js frontend
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000"

# Maximum upload size in megabytes
MAX_UPLOAD_SIZE_MB=25

# Document Chunking settings
CHUNK_SIZE_WORDS=600
CHUNK_OVERLAP_WORDS=100

# Local Embedding settings
OLLAMA_BASE_URL="http://127.0.0.1:11434"
EMBEDDING_MODEL="nomic-embed-text"

# Database settings
DATABASE_URL="postgresql+psycopg://vasuparmar@127.0.0.1:5432/ownmind"

# Search settings
SEARCH_MIN_SIMILARITY=0.5

# Question Answering settings
CHAT_MODEL="qwen2.5:3b"
ASK_TOP_K=5
MAX_CONTEXT_CHARACTERS=4000
